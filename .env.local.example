# --- TMDB (server-only) ---
# Get a free API key: https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (v4 bearer) OR the v3 API key — this app supports both.
TMDB_API_KEY=your_tmdb_v3_api_key_or_v4_read_token

# --- Supabase ---
# Create a free project at https://supabase.com, then Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Service role key (server-only, NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
